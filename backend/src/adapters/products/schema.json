{
  "type": "resourceGroup",
  "display": "section",
  "id": "products-group",
  "title": "Inventory",
  "items": [
    {
      "type": "resource",
      "id": "products",
      "name": "Live Products",
      "icon": "package",
      "endpoint": "/products",
      "views": {
        "listView": {
          "columns": [
            { "field": "id", "header": "ID" },
            { "field": "name", "header": "Product Name" },
            { "field": "stock", "header": "In Stock" }
          ]
        },
        "detailView": {
          "fields": [
            { "field": "id", "label": "Product ID" },
            { "field": "name", "label": "Product Name" },
            { "field": "stock", "label": "Stock Count" },
            { "field": "description", "label": "Description" }
          ]
        }
      },
      "actions": [
        {
          "type": "form",
          "id": "create-product",
          "name": "New Product",
          "target": "global",
          "method": "POST",
          "endpoint": "/products",
          "formSchema": {
            "schema": {
              "title": "Create New Product",
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "stock": { "type": "number", "title": "Initial Stock" },
                "description": { "type": "string" }
              }, "required": ["name", "stock"]
            }
          }
        },
        {
          "type": "simpleAction",
          "id": "delete-product",
          "name": "Delete",
          "target": "item",
          "method": "DELETE",
          "endpoint": "/products/{id}"
        }
      ]
    }
  ]
}