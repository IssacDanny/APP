{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://your-domain.com/schemas/adminPanelMetaSchema.v1.json",
  "title": "Admin Panel Meta-Schema",
  "description": "Defines the complete structure for generating an admin panel.",
  "type": "object",
  "properties": {
    "panelName": {
      "type": "string"
    },
    "navigation": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/navigationItem"
      }
    }
  },
  "required": ["panelName", "navigation"],
  "definitions": {
    "navigationItem": {
      "description": "A top-level item in the navigation bar.",
      "oneOf": [
        { "$ref": "#/definitions/topLevelResourceGroup" },
        { "$ref": "#/definitions/userMenu" }
      ]
    },

    "topLevelResourceGroup": {
      "allOf": [
        { "$ref": "#/definitions/baseResourceGroup" },
        { "properties": { "display": { "const": "section" } } }
      ]
    },

    "nestedResourceGroup": {
      "allOf": [
        { "$ref": "#/definitions/baseResourceGroup" },
        { "properties": { "display": { "const": "folder" } } }
      ]
    },

    "baseResourceGroup": {
      "type": "object",
      "properties": {
        "type": { "const": "resourceGroup" },
        "id": { "type": "string" },
        "title": { "type": "string" },
        "icon": { "type": "string" },
        "display": { "enum": ["section", "folder"] },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/resource" },
              { "$ref": "#/definitions/nestedResourceGroup" }
            ]
          }
        }
      },
      "required": ["type", "id", "title", "items"],
      "additionalProperties": false
    },
    
    "userMenu": {
      "type": "object",
      "properties": {
        "type": { "const": "userMenu" },
        "id": { "const": "user" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/userMenuItem" }
        }
      },
      "required": ["type", "id", "title", "items"],
      "additionalProperties": false
    },
    
    "userMenuItem": {
      "oneOf": [
        { "$ref": "#/definitions/navigationLinkAction" },
        { "$ref": "#/definitions/simpleApiAction" }
      ]
    },

    "resource": {
      "type": "object",
      "properties": {
        "type": { "const": "resource" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "endpoint": { "type": "string"},
        "views": {
          "type": "object",
          "properties": {
            "listView": { "$ref": "#/definitions/view-table" },
            "detailView": { "$ref": "#/definitions/view-details" }
          },
          "required": ["listView"]
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/action" }
        }
      },
      "required": ["type", "id", "name", "endpoint", "views"],
      "additionalProperties": false
    },

    "view-table": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "header": { "type": "string" }
            },
            "required": ["field", "header"]
          }
        }
      },
      "required": ["columns"]
    },

    "view-details": {
       "type": "object",
       "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "label": { "type": "string" }
              },
              "required": ["field", "label"]
            }
          }
        },
        "required": ["fields"]
    },
    
    "action": {
      "oneOf": [
        { "$ref": "#/definitions/formAction" },
        { "$ref": "#/definitions/simpleApiAction" }
      ]
    },

    "formAction": {
      "type": "object",
      "properties": {
        "type": { "const": "form" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "target": { "enum": ["global", "item"] },
        "method": { "enum": ["POST", "PUT", "PATCH"] },
        "endpoint": { "type": "string" },
        "formSchema": {
          "type": "object",
          "properties": {
            "schema": { "type": "object" },
            "uiSchema": { "type": "object" }
          },
          "required": ["schema"]
        },
        "payloadTransform": { "type": "string" },
        "dataMapTransform": { "type": "string" }
      },
      "required": ["type", "id", "name", "target", "method", "endpoint", "formSchema"]
    },

    "simpleApiAction": {
      "type": "object",
      "properties": {
        "type": { "const": "simpleAction" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "target": { "enum": ["global", "item", "none"] },
        "method": { "enum": ["POST", "DELETE", "GET"] },
        "endpoint": { "type": "string"},
        "confirmationText": { "type": "string" }
      },
      "required": ["type", "id", "name", "target", "method", "endpoint"]
    },

    "navigationLinkAction": {
      "type": "object",
      "properties": {
          "type": {"const": "navigationLink"},
          "id": {"type": "string"},
          "name": {"type": "string"},
          "targetResource": {"type": "string"},
          "targetView": {"enum": ["detailView", "listView"], "default": "detailView"},
          "targetId": {"type": "string"}
      },
      "required": ["type", "id", "name", "targetResource"]
    }
  }
}