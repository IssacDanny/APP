{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ViewSchema Grammar",
  "description": "The standard structure for a schema describing how to display data, either as a table or a detail page.",
  "type": "object",
  "properties": {
    "type": {
      "description": "MUST be 'view' to identify this as a display schema.",
      "const": "view"
    },
    "title": {
      "type": "string",
      "description": "The title for the view. Can use templates like 'Details for {name}'."
    },
    "viewType": {
      "type": "string",
      "description": "Determines the overall layout of the view.",
      "enum": ["table", "detail"]
    }
  },
  "required": ["type", "title", "viewType"],

  "allOf": [
    {
      "if": {
        "properties": { "viewType": { "const": "table" } }
      },
      "then": {
        "$ref": "#/definitions/TableViewProperties"
      }
    },
    {
      "if": {
        "properties": { "viewType": { "const": "detail" } }
      },
      "then": {
        "$ref": "#/definitions/DetailViewProperties"
      }
    }
  ],

  "definitions": {
    "TableViewProperties": {
      "properties": {
        "columns": {
          "type": "array",
          "description": "An ordered array of columns for the data table.",
          "minItems": 1,
          "items": { "$ref": "#/definitions/DisplayField" }
        }
      },
      "required": ["columns"]
    },

    "DetailViewProperties": {
      "properties": {
        "layout": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/DisplayField" },
              { "$ref": "#/definitions/LayoutSection" }
            ]
          }
        }
      },
      "required": ["layout"]
    },

    "LayoutSection": {
      "type": "object",
      "properties": {
        "type": { "const": "section" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/DisplayField" }
        }
      },
      "required": ["type", "title", "items"]
    },
    
    "DisplayField": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "The key from the data object to display."
        },
        "label": {
          "type": "string",
          "description": "The human-readable label for the field or column header."
        },
        "displayAs": {
          "type": "string",
          "description": "A hint for the UI on how to format the data.",
          "enum": ["text", "date", "currency", "badge", "textarea"],
          "default": "text"
        },
        "sortable": {
          "type": "boolean",
          "description": "For tables: whether the UI should allow sorting on this column.",
          "default": false
        }
      },
      "required": ["key", "label"]
    }
  }
}